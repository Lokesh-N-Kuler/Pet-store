# ==============================================================================
# JIVVI E-COMMERCE ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL SECRETS OR .env FILES TO VERSION CONTROL.
# Copy this file to .env and replace placeholders with your real credentials.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client - Safe for browser)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://mcpzeukgtmzplpjmhyqy.supabase.co

# Your Supabase Anonymous Public Key (Safe to expose in browser bundle)
VITE_SUPABASE_ANON_KEY=sb_publishable_oIMiEZYbJq22iXHwYnSwdw_g-Z3AxQ4

# Razorpay Key ID (Public test or live key, e.g. rzp_test_xxxxxxxx or rzp_live_xxxxxxxx)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE & SUPABASE EDGE FUNCTIONS SECRETS
# Configure via: supabase secrets set KEY=VALUE
# ------------------------------------------------------------------------------
# Razorpay Key Secret (CONFIDENTIAL: NEVER EXPOSE TO CLIENT)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Supabase Service Role Key (CONFIDENTIAL: Edge Functions internal use only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
